# Copy to .env and replace every CHANGE_ME value.
# ---- デモ当日の基本設定 ----
PANME_DEMO_MODE=true
PANME_USE_API=false
# Raspberry Piでサーボを動かす場合はfalse。PC上のUI確認ではtrue。
PANME_MOCK_MODE=false
PANME_FULLSCREEN=true
PANME_DEBUG_MODE=true
PANME_SCREEN_TIMEOUT=60

# API使用デモで接続できない場合、デモ商品へ安全に退避するか。
# trueの場合も実機サーボ設定はPANME_MOCK_MODEに従います。
PANME_DEMO_API_FALLBACK=true
# falseならデモ商品在庫を減らさず、同じ撮影を繰り返せます。
PANME_DEMO_DECREASE_STOCK=false

PANME_DEMO_USER_ID=001
PANME_DEMO_USER_NAME=大崎　蒼
PANME_DEMO_STUDENT_ID=123456

# ---- Web API設定 ----
# XAMPPでhtdocs/PanMeへ置く場合。ドキュメントルート直下なら /PanMe は不要です。
PANME_API_BASE_URL=http://192.168.1.100/PanMe
PANME_API_KEY=CHANGE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS
PANME_DEVICE_ID=PANME-LOCKER-01
PANME_DEVICE_NAME=PanMe School Locker
PANME_SOFTWARE_VERSION=4.0.0

# Temporary STEP4 production-mode identity.
# QR/NFC services will replace this in later steps.
PANME_USER_ID=1
PANME_AUTHENTICATION_METHOD=STEP4_DEMO

PANME_API_CONNECT_TIMEOUT=5
PANME_API_READ_TIMEOUT=10
PANME_API_MAX_RETRIES=3
PANME_HEARTBEAT_INTERVAL=30
PANME_VERIFY_TLS=true
PANME_CA_BUNDLE=

# ---- ハードウェア設定 ----
PANME_PCA9685_ADDRESS=0x40
PANME_I2C_BUS_NUMBER=1
